{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "audio/*",
      "use": "@vercel/static"
    },
    {
      "src": "js/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/audio/(.+\\.mp3)",
      "headers": {
        "Content-Type": "audio/mpeg"
      },
      "dest": "/audio/$1"
    },
    {
      "src": "/audio/(.+\\.json)",
      "headers": {
        "Content-Type": "application/json"
      },
      "dest": "/audio/$1"
    },
    {
      "src": "/js/(.+\\.mjs)",
      "headers": {
        "Content-Type": "text/javascript; charset=utf-8"
      },
      "dest": "/js/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
